generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  isActive              Boolean @default(true)
  isProtectedSuperAdmin Boolean @default(false) @map("is_protected_super_admin")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                 Session[]
  accounts                 Account[]
  roles                    UserRole[]
  sentAdminInvitations     AdminInvitation[]    @relation("AdminInvitationInviter")
  acceptedAdminInvitations AdminInvitation[]    @relation("AdminInvitationAcceptedUser")
  adminAccessRemovals      AdminAccessRemoval[] @relation("AdminAccessRemovalTarget")
  removedAdminAccesses     AdminAccessRemoval[] @relation("AdminAccessRemovalActor")
  createdProducts          Product[]            @relation("ProductCreatedBy")
  stagedProductImages      ProductImage[]       @relation("ProductImageUploader")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  slug         String    @unique @db.VarChar(100)
  description  String?
  scope        RoleScope @default(ADMIN)
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")

  users       UserRole[]
  permissions RolePermission[]
  invitations AdminInvitationRole[]

  createdAt DateTime @default(now())

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

enum RoleScope {
  ADMIN
  CUSTOMER
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AdminInvitationEmailStatus {
  NOT_ATTEMPTED
  SENDING
  ACCEPTED_BY_PROVIDER
  FAILED
  UNKNOWN
}

model AdminInvitation {
  id                     String                     @id @default(uuid()) @db.Uuid
  email                  String                     @db.VarChar(320)
  name                   String                     @db.VarChar(200)
  tokenHash              String                     @unique @map("token_hash") @db.VarChar(64)
  status                 AdminInvitationStatus      @default(PENDING)
  expiresAt              DateTime                   @map("expires_at")
  sentAt                 DateTime?                  @map("sent_at")
  emailProvider          String                     @default("SMTP") @map("email_provider") @db.VarChar(20)
  emailStatus            AdminInvitationEmailStatus @default(NOT_ATTEMPTED) @map("email_status")
  providerEmailId        String?                    @map("provider_email_id") @db.VarChar(120)
  providerResponse       String?                    @map("provider_response") @db.Text
  emailAttemptedAt       DateTime?                  @map("email_attempted_at")
  lastEmailError         String?                    @map("last_email_error")
  inviteeExistedAtInvite Boolean                    @default(false) @map("invitee_existed_at_invite")
  acceptedAt             DateTime?                  @map("accepted_at")
  revokedAt              DateTime?                  @map("revoked_at")
  invitedById            String                     @map("invited_by_id")
  acceptedUserId         String?                    @map("accepted_user_id")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  invitedBy    User                  @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser User?                 @relation("AdminInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  roles        AdminInvitationRole[]

  @@index([email, status])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@map("admin_invitations")
}

model AdminAccessRemoval {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @map("user_id")
  removedById      String                     @map("removed_by_id")
  recipientEmail   String                     @map("recipient_email") @db.VarChar(320)
  recipientName    String                     @map("recipient_name") @db.VarChar(200)
  removedRoles     Json                       @map("removed_roles") @db.JsonB
  emailProvider    String                     @default("SMTP") @map("email_provider") @db.VarChar(20)
  emailStatus      AdminInvitationEmailStatus @default(NOT_ATTEMPTED) @map("email_status")
  providerEmailId  String?                    @map("provider_email_id") @db.VarChar(120)
  providerResponse String?                    @map("provider_response") @db.Text
  emailAttemptedAt DateTime?                  @map("email_attempted_at")
  lastEmailError   String?                    @map("last_email_error") @db.Text
  createdAt        DateTime                   @default(now()) @map("created_at")

  user      User @relation("AdminAccessRemovalTarget", fields: [userId], references: [id], onDelete: Restrict)
  removedBy User @relation("AdminAccessRemovalActor", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([removedById])
  @@index([emailStatus, createdAt])
  @@map("admin_access_removals")
}

// Append-only from the application: no update/delete API is provided.
// Snapshots are stored as scalar/JSON data so the history survives account or role changes.
model AdminAuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  actorUserId       String?  @map("actor_user_id")
  actorName         String?  @map("actor_name") @db.VarChar(200)
  actorEmail        String?  @map("actor_email") @db.VarChar(320)
  actorRoles        Json?    @map("actor_roles") @db.JsonB
  actorIsSuperAdmin Boolean? @map("actor_is_super_admin")
  action            String   @db.VarChar(100)
  category          String   @db.VarChar(50)
  riskLevel         String   @default("LOW") @map("risk_level") @db.VarChar(20)
  description       String   @db.Text
  targetType        String   @map("target_type") @db.VarChar(50)
  targetId          String?  @map("target_id")
  targetName        String?  @map("target_name") @db.VarChar(200)
  targetEmail       String?  @map("target_email") @db.VarChar(320)
  roleId            String?  @map("role_id") @db.Uuid
  roleName          String?  @map("role_name") @db.VarChar(100)
  permissionId      String?  @map("permission_id") @db.Uuid
  permissionKey     String?  @map("permission_key") @db.VarChar(160)
  beforeState       Json?    @map("before_state") @db.JsonB
  afterState        Json?    @map("after_state") @db.JsonB
  changedFields     Json?    @map("changed_fields") @db.JsonB
  requestIp         String?  @map("request_ip") @db.VarChar(100)
  userAgent         String?  @map("user_agent") @db.Text
  requestId         String?  @map("request_id") @db.VarChar(200)
  success           Boolean  @default(true)
  failureCode       String?  @map("failure_code") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([category, createdAt])
  @@index([action, createdAt])
  @@index([riskLevel, createdAt])
  @@index([roleId, createdAt])
  @@index([permissionKey, createdAt])
  @@map("admin_audit_logs")
}

model AdminInvitationRole {
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@map("admin_invitation_roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductGender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

model ProductCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(100)
  slug        String            @unique @db.VarChar(120)
  description String?           @db.Text
  parentId    String?           @map("parent_id") @db.Uuid
  parent      ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProductCategory[] @relation("ProductCategoryTree")
  products    Product[]
  archivedAt  DateTime?         @map("archived_at")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId, archivedAt, sortOrder, name])
  @@index([name])
  @@map("product_categories")
}

model Product {
  id             String           @id @default(cuid()) @db.VarChar(30)
  title          String           @db.VarChar(200)
  slug           String           @unique @db.VarChar(220)
  description    String           @db.Text
  detailsAndCare String[]         @default([]) @map("details_and_care")
  gender         ProductGender    @default(UNISEX)
  categoryId     String           @map("category_id") @db.Uuid
  category       ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price          Decimal          @db.Decimal(10, 2)
  multibuyPrice  Decimal?         @map("multibuy_price") @db.Decimal(10, 2)
  currency       String           @default("GBP") @db.Char(3)
  status         ProductStatus    @default(DRAFT)
  tags           String[]         @default([])
  isNew          Boolean          @default(false) @map("is_new")
  bestsellerRank Int?             @map("bestseller_rank")
  createdById    String?          @map("created_by_id")
  createdBy      User?            @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  archivedAt     DateTime?        @map("archived_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([title])
  @@map("products")
}

model ProductImage {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String?         @map("product_id") @db.VarChar(30)
  product      Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId    String?         @map("variant_id") @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  uploadedById String          @map("uploaded_by_id")
  uploadedBy   User            @relation("ProductImageUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  provider     String          @default("CLOUDINARY") @db.VarChar(20)
  publicId     String          @unique @map("public_id") @db.VarChar(255)
  secureUrl    String          @map("secure_url") @db.Text
  format       String          @db.VarChar(12)
  altText      String?         @map("alt_text") @db.VarChar(250)
  sortOrder    Int             @default(0) @map("sort_order")
  isPrimary    Boolean         @default(false) @map("is_primary")
  deletedAt    DateTime?       @map("deleted_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([productId, deletedAt, sortOrder])
  @@index([variantId, deletedAt, sortOrder])
  @@index([uploadedById, productId, createdAt])
  @@map("product_images")
}

model ProductVariant {
  id            String         @id @default(uuid()) @db.Uuid
  productId     String         @map("product_id") @db.VarChar(30)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  name          String         @db.VarChar(120)
  sku           String?        @unique @db.VarChar(100)
  size          String?        @db.VarChar(40)
  colorName     String?        @map("color_name") @db.VarChar(80)
  colorHex      String?        @map("color_hex") @db.VarChar(7)
  priceOverride Decimal?       @map("price_override") @db.Decimal(10, 2)
  stockQuantity Int            @default(0) @map("stock_quantity")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([productId, isActive])
  @@index([productId, stockQuantity])
  @@map("product_variants")
}

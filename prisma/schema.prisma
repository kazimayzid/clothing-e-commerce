generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String  @id
  name          String
  email         String
  emailVerified Boolean @default(false)
  image         String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions                 Session[]
  accounts                 Account[]
  roles                    UserRole[]
  sentAdminInvitations     AdminInvitation[]    @relation("AdminInvitationInviter")
  acceptedAdminInvitations AdminInvitation[]    @relation("AdminInvitationAcceptedUser")
  adminAccessRemovals      AdminAccessRemoval[] @relation("AdminAccessRemovalTarget")
  removedAdminAccesses     AdminAccessRemoval[] @relation("AdminAccessRemovalActor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Role {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  slug         String    @unique @db.VarChar(100)
  description  String?
  scope        RoleScope @default(ADMIN)
  isSuperAdmin Boolean   @default(false) @map("is_super_admin")

  users       UserRole[]
  permissions RolePermission[]
  invitations AdminInvitationRole[]

  createdAt DateTime @default(now())

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(100)
  resource    String  @db.VarChar(100)
  action      String  @db.VarChar(50)
  description String?

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

enum RoleScope {
  ADMIN
  CUSTOMER
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum AdminInvitationEmailStatus {
  NOT_ATTEMPTED
  SENDING
  ACCEPTED_BY_PROVIDER
  FAILED
  UNKNOWN
}

model AdminInvitation {
  id                     String                     @id @default(uuid()) @db.Uuid
  email                  String                     @db.VarChar(320)
  name                   String                     @db.VarChar(200)
  tokenHash              String                     @unique @map("token_hash") @db.VarChar(64)
  status                 AdminInvitationStatus      @default(PENDING)
  expiresAt              DateTime                   @map("expires_at")
  sentAt                 DateTime?                  @map("sent_at")
  emailProvider          String                     @default("SMTP") @map("email_provider") @db.VarChar(20)
  emailStatus            AdminInvitationEmailStatus @default(NOT_ATTEMPTED) @map("email_status")
  providerEmailId        String?                    @map("provider_email_id") @db.VarChar(120)
  providerResponse       String?                    @map("provider_response") @db.Text
  emailAttemptedAt       DateTime?                  @map("email_attempted_at")
  lastEmailError         String?                    @map("last_email_error")
  inviteeExistedAtInvite Boolean                    @default(false) @map("invitee_existed_at_invite")
  acceptedAt             DateTime?                  @map("accepted_at")
  revokedAt              DateTime?                  @map("revoked_at")
  invitedById            String                     @map("invited_by_id")
  acceptedUserId         String?                    @map("accepted_user_id")
  createdAt              DateTime                   @default(now()) @map("created_at")
  updatedAt              DateTime                   @updatedAt @map("updated_at")

  invitedBy    User                  @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser User?                 @relation("AdminInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  roles        AdminInvitationRole[]

  @@index([email, status])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@map("admin_invitations")
}

model AdminAccessRemoval {
  id               String                     @id @default(uuid()) @db.Uuid
  userId           String                     @map("user_id")
  removedById      String                     @map("removed_by_id")
  recipientEmail   String                     @map("recipient_email") @db.VarChar(320)
  recipientName    String                     @map("recipient_name") @db.VarChar(200)
  removedRoles     Json                       @map("removed_roles") @db.JsonB
  emailProvider    String                     @default("SMTP") @map("email_provider") @db.VarChar(20)
  emailStatus      AdminInvitationEmailStatus @default(NOT_ATTEMPTED) @map("email_status")
  providerEmailId  String?                    @map("provider_email_id") @db.VarChar(120)
  providerResponse String?                    @map("provider_response") @db.Text
  emailAttemptedAt DateTime?                  @map("email_attempted_at")
  lastEmailError   String?                    @map("last_email_error") @db.Text
  createdAt        DateTime                   @default(now()) @map("created_at")

  user      User @relation("AdminAccessRemovalTarget", fields: [userId], references: [id], onDelete: Restrict)
  removedBy User @relation("AdminAccessRemovalActor", fields: [removedById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([removedById])
  @@index([emailStatus, createdAt])
  @@map("admin_access_removals")
}

model AdminInvitationRole {
  invitationId String @map("invitation_id") @db.Uuid
  roleId       String @map("role_id") @db.Uuid

  invitation AdminInvitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  role       Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([invitationId, roleId])
  @@index([roleId])
  @@map("admin_invitation_roles")
}

model UserRole {
  userId String @map("user_id")
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}
